[
  {
    "id": "component.button",
    "kind": "component",
    "title": "Button",
    "description": "A native button with a restrained set of intent, size, and loading states.",
    "category": "actions",
    "tags": ["action", "form", "primary", "secondary", "destructive"],
    "api": {
      "tag": "ov-button",
      "importPath": "./components/ovlira/button.js",
      "props": [
        { "name": "variant", "type": "'primary' | 'secondary' | 'quiet' | 'danger'", "description": "Visual and semantic intent.", "default": "primary", "reflected": true },
        { "name": "size", "type": "'sm' | 'md' | 'lg'", "description": "Control height and padding.", "default": "md", "reflected": true },
        { "name": "loading", "type": "boolean", "description": "Disables the button and communicates progress.", "default": "false", "reflected": true },
        { "name": "disabled", "type": "boolean", "description": "Prevents interaction.", "default": "false", "reflected": true }
      ],
      "events": [],
      "slots": ["default: button label"],
      "cssCustomProperties": ["--ov-button-radius"],
      "parts": ["button"]
    },
    "guidance": {
      "useWhen": ["The user needs to submit, confirm, or move forward."],
      "avoidWhen": ["The action is navigation; use a native link instead."],
      "constraints": ["Use one primary button per form or task region.", "Keep the label action-first and specific."],
      "requiredProps": [],
      "disallowedChildren": ["ov-button"],
      "example": "examples/components/button.md"
    }
  },
  {
    "id": "component.textarea",
    "kind": "component",
    "title": "Textarea",
    "description": "A labelled native multiline text field with help, error, and required states.",
    "category": "forms",
    "tags": ["form", "text", "long-form", "field", "validation"],
    "api": {
      "tag": "ov-textarea",
      "importPath": "./components/ovlira/textarea.js",
      "props": [
        { "name": "label", "type": "string", "description": "Visible accessible label.", "required": true, "reflected": true },
        { "name": "name", "type": "string", "description": "Native form field name.", "reflected": true },
        { "name": "value", "type": "string", "description": "Current textarea value." },
        { "name": "placeholder", "type": "string", "description": "Optional prompt for the expected content.", "reflected": true },
        { "name": "rows", "type": "number", "description": "Visible text rows.", "default": "4", "reflected": true },
        { "name": "required", "type": "boolean", "description": "Marks the field as required.", "default": "false", "reflected": true },
        { "name": "disabled", "type": "boolean", "description": "Prevents interaction.", "default": "false", "reflected": true },
        { "name": "error", "type": "string", "description": "Validation message." },
        { "name": "helpText", "type": "string", "description": "Supporting guidance.", "reflected": false }
      ],
      "events": [{ "name": "input", "description": "Native input event retargeted from the shadow root." }],
      "slots": [],
      "cssCustomProperties": ["--ov-field-accent"],
      "parts": ["field", "label", "textarea", "message"]
    },
    "guidance": {
      "useWhen": ["A user must enter a short-to-medium length multiline value."],
      "avoidWhen": ["The response is a single short value; use ov-input instead."],
      "constraints": ["Always provide a visible label; placeholder text is not a label.", "Keep the field sized to the expected response rather than the entire page."],
      "requiredProps": ["label"],
      "example": "examples/components/textarea.md"
    }
  },
