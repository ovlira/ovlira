{
  "name": "@ovlira/cli",
  "version": "0.3.0",
  "description": "A local, token-efficient UI prototyping toolkit for coding agents.",
  "keywords": [
    "design-system",
    "lit",
    "web-components",
    "custom-elements",
    "coding-agents",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovlira/ovlira.git"
  },
  "bugs": {
    "url": "https://github.com/ovlira/ovlira/issues"
  },
  "homepage": "https://github.com/ovlira/ovlira#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ovlira": "dist/cli/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && npm run build --workspace @ovlira/elements && tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "ovlira": "node dist/cli/bin.js",
    "manifest": "cem analyze --litelement",
    "metadata:check": "node dist/cli/index.js metadata --json",
    "review:visual": "vite --config examples/visual-review/vite.config.ts",
    "review:visual:build": "vite build --config examples/visual-review/vite.config.ts",
    "marketing:dev": "npm --prefix examples/marketing run dev --",
    "marketing:build": "npm --prefix examples/marketing run build",
    "marketing:preview": "npm --prefix examples/marketing run preview",
    "reference:design": "vite --config examples/design-reference/vite.config.ts",
    "reference:design:build": "vite build --config examples/design-reference/vite.config.ts",
    "test:browser": "playwright test tests/browser/review.spec.ts",
    "test:visual": "playwright test tests/browser/visual.spec.ts tests/browser/reference.spec.ts tests/browser/marketing.spec.ts",
    "test:visual:update": "playwright test tests/browser/visual.spec.ts tests/browser/reference.spec.ts tests/browser/marketing.spec.ts --update-snapshots",
    "test:component-visual": "playwright test --config playwright.component-visual.config.ts",
    "test:component-visual:update": "playwright test --config playwright.component-visual.config.ts --update-snapshots && npm run component-visual:manifest",
    "component-visual:manifest": "node scripts/generate-component-visual-manifest.mjs",
    "component-visual:approve": "node scripts/generate-component-visual-manifest.mjs --approve",
    "test:ui": "playwright test",
    "pack:check": "npm pack --dry-run && npm pack --dry-run --workspace @ovlira/elements",
    "package:smoke": "node scripts/package-smoke.mjs",
    "adaptation:check": "npm --prefix examples/adaptation run build && npm run ovlira -- check --cwd examples/adaptation --json",
    "release:check:package": "npm test && npm run manifest && npm run check:fixtures && npm run adaptation:check && npm run reference:design:build && npm run review:visual:build && npm run marketing:build && npm run pack:check && npm run package:smoke",
    "release:check": "npm run release:check:package && npm run test:ui && npm run test:component-visual",
    "eval:codex": "npm run build && node dist/evals/runner.js",
    "benchmark:codex": "npm run build && node dist/evals/runner.js --runs 3",
    "eval:codex:offline": "npm run build && node dist/evals/runner.js --offline",
    "eval:specs": "npm run build && node dist/evals/spec-runner.js",
    "eval:specs:vitest": "npm run build && node dist/evals/spec-runner.js --render --run",
    "check:fixtures": "node dist/cli/index.js check --json --cwd tests/fixtures/valid-project && ! node dist/cli/index.js check --json --cwd tests/fixtures/invalid-project"
  },
  "dependencies": {
    "@ovlira/elements": "0.3.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@custom-elements-manifest/analyzer": "^0.10.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "astro": "^5.14.1",
    "jsdom": "^26.1.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.42",
    "wrangler": "^4.127.1"
  }
}
